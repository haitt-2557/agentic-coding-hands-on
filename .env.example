# Homepage SAA 2025 — public (client-visible) config. Copy to `.env.local` for local dev;
# never commit real secrets here — these are all placeholders, and none of them are secret.

# ALG-001 — ISO-8601 target instant for the hero countdown. ~90 days out by default so dev
# shows "Coming soon" with non-zero DAYS/HOURS/MINUTES. An empty or unparseable value falls
# back to the zero state without crashing (BR-003).
#
# This same value also drives the app-wide launch gate (proxy.ts + lib/prelaunch/gate.ts):
# while it is in the future every route except /prelaunch redirects there; once it has
# passed, /prelaunch redirects to /. There is no separate kill switch for the gate — a
# missing or unparseable value here fails OPEN (the gate does not engage, every route stays
# reachable) rather than locking the site behind a dead countdown.
NEXT_PUBLIC_EVENT_START_AT=2026-12-19T18:30:00+07:00

# Mock session seed (see lib/session/session-provider.tsx — NOT a security boundary).
# Fallback only: localStorage ("saa.mock-role" / "saa.mock-unread") wins when set.
# One of: guest | user | admin
NEXT_PUBLIC_MOCK_ROLE=guest
# Non-negative integer unread notification count.
NEXT_PUBLIC_MOCK_UNREAD_COUNT=0

# Supabase local auth (login screen). `supabase start` must be running — see
# supabase/config.toml. Copy the URL and publishable key that command prints into
# .env.local; the values below are placeholders and will not reach a real stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Seeded E2E fixture user (see supabase/seed.sql) — local-only, never a real account.
E2E_TEST_USER_EMAIL=e2e-login@example.com
E2E_TEST_USER_PASSWORD=e2e-local-only-password

# Google OAuth client, read by supabase/config.toml's `env(...)` substitution from the
# root .env (not .env.local — the Supabase CLI reads its own .env at repo root). These
# are user-supplied secrets; until the real values land, the stack still starts and the
# Supabase authorize redirect still fires (verified 2026-08-19, see
# plans/260819-1432-login-supabase-auth/evidence/phase-01-infrastructure.md) — only a
# real Google account round trip is blocked.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=000000000000-localdevplaceholder.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=GOCSPX-local-dev-placeholder
