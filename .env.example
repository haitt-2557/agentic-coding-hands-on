# Homepage SAA 2025 — public (client-visible) config. Copy to `.env.local` for local dev;
# never commit real secrets here — these are all placeholders, and none of them are secret.

# ALG-001 — ISO-8601 target instant for the hero countdown. ~90 days out by default so dev
# shows "Coming soon" with non-zero DAYS/HOURS/MINUTES. An empty or unparseable value falls
# back to the zero state without crashing (BR-003).
NEXT_PUBLIC_EVENT_START_AT=2026-12-19T18:30:00+07:00

# Mock session seed (see lib/session/session-provider.tsx — NOT a security boundary).
# Fallback only: localStorage ("saa.mock-role" / "saa.mock-unread") wins when set.
# One of: guest | user | admin
NEXT_PUBLIC_MOCK_ROLE=guest
# Non-negative integer unread notification count.
NEXT_PUBLIC_MOCK_UNREAD_COUNT=0
